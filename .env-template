#LLMS
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_LLM=claude-opus-4-6
OPENAI_API_KEY=sk-proj-....
OPENAI_LLM=gpt-5-mini
GOOGLE_API_KEY=AQ.Ab...
GOOGLE_LLM=gemini-1.5-flash
LOCAL_LLM=qwen3:14b

# PROVEEDOR_LLM: "anthropic"/"gemini"/"openai"/"local", o directamente el NOMBRE
# de un modelo de Ollama (ej. "gemma4:latest", "qwen3:14b"). "local" toma el
# modelo de LOCAL_LLM; un nombre de modelo se usa tal cual contra Ollama.
PROVEEDOR_LLM=anthropic
EXTRACTOR_MODEL=openai
EMBED_DEVICE=mps
PYTORCH_ENABLE_MPS_FALLBACK=1
EMBED_MODEL=bge-m3

# Evaluación automatizada (evaluation/run_golden.py) — ver docs/evaluacion.md
JUEZ_LLM_PROVIDER=openai   # proveedor del juez LLM (run_judge.py)
EVAL_LLM_PROVIDER=openai   # proveedor del juez en el golden set (run_golden.py)
RAGAS_LLM_MODEL=gpt-4o-mini            # RAGas: modelo NO-razonador (los gpt-5*/o* rechazan temperature!=1)
RAGAS_EMBED_MODEL=text-embedding-3-small
RAGAS_TIMEOUT=600                      # seg; informes largos superan el default (180s) y darían NaN

# SQL Server
SQLSERVER_HOST=192.168.253.25
SQLSERVER_INSTANCE=sql2019
SQLSERVER_DB=MUTUAL_ONLINE
SQLSERVER_USER=desarrollo
SQLSERVER_PASSWORD=....

# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=embeddings
POSTGRES_USER=embeddings
POSTGRES_PASSWORD=...

# BCRA — Central de Deudores (consulta por CUIT, API pública sin API key)
# OJO: consultar el BCRA envía el CUIT a un API externo. Poné BCRA_ENABLED=false
# para mantener el sistema 100% on-premise.
BCRA_ENABLED=true
BCRA_API_BASE=https://api.bcra.gob.ar/centraldedeudores/v1.0
BCRA_TTL_DIAS=30          # el BCRA actualiza mensual; se cachea por CUIT
BCRA_TIMEOUT=15           # segundos por request
BCRA_VERIFY_SSL=true      # poné false si tu red no resuelve la cadena TLS del BCRA

# Tunning threading
KMP_DUPLICATE_LIB_OK=TRUE

EMPRESA_NOMBRE=Mutual Nacional

# Modo administrador (ver/editar prompts y regenerar secciones desde la web).
# Contraseña compartida para entrar al modo admin. Si queda VACÍO, el modo admin
# se deshabilita por completo (default seguro).
ADMIN_PASSWORD=